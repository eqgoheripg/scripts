local function randomPark()
	local idx
	repeat
		idx = math.random(1, #AutoReadyState.ESTACIONAMENTOS)
	until idx ~= AutoReadyState.lastIndex
	AutoReadyState.lastIndex = idx
	return AutoReadyState.ESTACIONAMENTOS[idx]
end

local function moveToFor(target, duration)
	local t0   = tick()
	local char = LocalPlayer.Character
	local hum  = char and char:FindFirstChild("Humanoid")
	if not hum then return end
	local conn
	conn = RunService.RenderStepped:Connect(function()
		hum:MoveTo(target)
		if tick() - t0 >= duration then conn:Disconnect() end
	end)
end

local function doReady()
	moveToFor(AutoReadyState.DESTINO, 1.2)
	task.wait(1.3)
	moveToFor(randomPark(), 1.2)
end

local function setupAutoReadyConn()
	if AutoReadyState.conn then return end
	AutoReadyState.conn = LocalPlayer
		:GetAttributeChangedSignal("IsInGame"):Connect(function()
		local inGame = LocalPlayer:GetAttribute("IsInGame")
		if State.AutoReady
		and inGame ~= true
		and not AutoReadyState.executedForFalse then
			AutoReadyState.executedForFalse = true
			AutoReadyState.pendingToken     = AutoReadyState.pendingToken + 1
			local tok = AutoReadyState.pendingToken
			task.delay(5, function()
				if tok ~= AutoReadyState.pendingToken then return end
				if State.AutoReady
				and LocalPlayer:GetAttribute("IsInGame") ~= true then
					doReady()
				end
			end)
		elseif inGame == true then
			AutoReadyState.executedForFalse = false
			AutoReadyState.pendingToken     = AutoReadyState.pendingToken + 1
		end
	end)
end

