local BallHook = {}

function BallHook.findClass()
	if type(getgc) ~= "function" then return nil end
	local ok, gc = pcall(getgc)
	if not ok then return nil end
	local seen = {}
	for _, fn in pairs(gc) do
		if type(fn) == "function" then
			local s_ok, src = pcall(debug.info, fn, "s")
			if s_ok and type(src) == "string" and src:find("lBall", 1, true) then
				local u_ok, ups = pcall(debug.getupvalues, fn)
				if u_ok then
					for _, up in ipairs(ups) do
						if type(up) == "table" and not seen[up] and typeof(up) ~= "Instance" then
							local r_ok, render = pcall(function() return rawget(up, "Render") end)
							if r_ok and type(render) == "function" then
								seen[up] = true
								return up
							end
						end
					end
				end
			end
		end
	end
	return nil
end

function BallHook.hookDestroy(body, bd)
	if bd._destroyHooked then return end
	bd._destroyHooked = true
	body.Destroying:Connect(function()
		BallSystem.Balls[body] = nil
		if BallSystem.Active == bd then BallSystem.Active = nil end
	end)
end

function BallHook.hookTargetChange(ballObj, bd)
	local cfs = ballObj._changeFunctions
	if not cfs then return end
	local orig = cfs.TargetUserId
	if not orig then return end
	cfs.TargetUserId = function(uid)
		BallSystem.ParriedLoop = {}
		if uid then bd.Target = Players:GetPlayerByUserId(tonumber(uid)) end
		orig(uid)
	end
end

function BallHook.update(ballObj, bd)
	bd.Type             = ballObj.Type
	bd.isSeekDisabled   = ballObj.isSeekDisabled
	bd.isPhasingThrough = ballObj.isPhasingThrough

	if ballObj.Anchored then
		bd.AnchoredAt = bd.AnchoredAt or os.clock()
	else
		bd.AnchoredAt = nil
	end

	if ballObj.isSeekDisabled and ballObj.Anchored then
		bd.BothTrueAt = os.clock()
	end

	local prevPos     = bd.Position
	bd.Velocity       = ballObj.Velocity
	bd.Position       = ballObj.Position
	local dt          = os.clock() - (BallSystem.LastRender or 0)
	local lp          = bd.LastPosition or bd.Position
	bd.ObjectVelocity = (dt > 0) and (bd.Position - lp) / dt or Vector3.zero
	bd.LastPosition   = bd.Position

	if not prevPos or (bd.Position - prevPos).Magnitude > 0.5 then
		bd.LastMovedAt = os.clock()
	end
	bd.LastMovedAt = bd.LastMovedAt or os.clock()

	if bd.Velocity and bd.Velocity.Magnitude > 1 then
		bd.LastKnownVelocity = bd.Velocity
	end

	local tgtDist = ballObj.Target
		and (bd.Position - ballObj.Target.Position).Magnitude or 1e9
	local now = os.clock()

	bd.LagStuck = (
		not ballObj.Anchored
		and bd.Type == "Default"
		and ballObj.Target == LocalPlayer
		and now - bd.LastMovedAt > 1
		and tgtDist < 60
	)

	if ballObj.TargetUserId and not bd.Target then
		bd.Target = Players:GetPlayerByUserId(tonumber(ballObj.TargetUserId))
	end

	bd.DistanceFromTarget = ballObj.Target
		and (bd.Position - ballObj.Target.Position) or nil
end

function BallHook.elect(bd)
	if not ParryConfig.Types[bd.Type] then return end
	local active = BallSystem.Active
	if not active or not ParryConfig.Types[active.Type] then
		BallSystem.Active = bd; return
	end
	if active == bd then return end
	local d1 = bd.DistanceFromTarget     and bd.DistanceFromTarget.Magnitude
	local d2 = active.DistanceFromTarget and active.DistanceFromTarget.Magnitude
	if d1 and (not d2 or d1 < d2) then BallSystem.Active = bd end
end

function BallHook.hook(cls)
	local ok, hooked = pcall(function() return rawget(cls, "__FINISH_HOOKED") end)
	if ok and hooked then return true end
	local rok, render = pcall(function() return rawget(cls, "Render") end)
	if not rok or type(render) ~= "function" then return false end
	Utils.removeMeta(cls)
	local origRender = render
	local function newRender(ballObj)
		pcall(function()
			if not ballObj
			or type(ballObj) ~= "table"
			or typeof(ballObj.Body) ~= "Instance" then return end
			local bd = BallSystem.Balls[ballObj.Body]
			if not bd then
				bd = {Object = ballObj.Body}
				BallSystem.Balls[ballObj.Body] = bd
				BallHook.hookDestroy(ballObj.Body, bd)
				BallHook.hookTargetChange(ballObj, bd)
			end
			BallHook.update(ballObj, bd)
			BallHook.elect(bd)
		end)
		local ok2, res = pcall(origRender, ballObj)
		BallSystem.LastRender = os.clock()
		if ok2 then return res end
	end
	if not pcall(function() rawset(cls, "Render", newRender) end) then
		cls.Render = newRender
	end
	pcall(function() rawset(cls, "__FINISH_HOOKED", true) end)
	State.Hooked = true
	return true
end

task.spawn(function()
	for _ = 1, 120 do
