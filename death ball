local AutoParry = {}

function AutoParry.gate(bd, hrpPos)
	if bd.Type ~= "Default" then return false end
	local body = bd.Object
	if not body or body.Transparency >= 1 then return false end
	local moving = (bd.Velocity and bd.Velocity.Magnitude > 0)
		or (bd.ObjectVelocity and bd.ObjectVelocity.Magnitude > 0)
	if not moving and not bd.LagStuck then return false end
	if not ParryConfig.Types[bd.Type] then return false end
	if bd.Target ~= LocalPlayer then return false end
	local dist = (bd.DistanceFromTarget and bd.DistanceFromTarget.Magnitude)
		or (bd.Position and (bd.Position - hrpPos).Magnitude)
	if not dist then return false end
	local effMax = Utils.pingDist()
	local hrpVel = Vector3.zero
	local char   = LocalPlayer.Character
	if char and char.PrimaryPart then
		hrpVel = char.PrimaryPart.AssemblyLinearVelocity
	end
	local bVel = (bd.LagStuck and bd.LastKnownVelocity)
		or bd.Velocity or Vector3.zero
	local dir    = (bd.Position or hrpPos) - hrpPos
	local relDot = 0
	if dir.Magnitude > 0 then
		relDot = dir.Unit:Dot(hrpVel) - dir.Unit:Dot(bVel)
	end
	local spd = math.clamp(math.max(bVel.Magnitude, relDot, 0) / 500, 0, 3)
	if dist > effMax + (30 - effMax) * 0.25 * spd then return false end
	local bypass = bd.BothTrueAt
		and (os.clock() - bd.BothTrueAt <= ParryConfig.BypassWindow)
	if not bypass then
		if State.Gazo
		and bd.isSeekDisabled
		and bVel.Magnitude > ParryConfig.SpeedExempt then return false end
		if not bd.LagStuck
		and bd.AnchoredAt
		and (os.clock() - bd.AnchoredAt > ParryConfig.AnchorTimeout) then
			return false
		end
	end
	return true
end

function AutoParry.confirm(bd, ping, extra, hrpPos, hrpVel)
	local predHRP  = hrpPos  - hrpVel * (ping + extra)
	local predBall = bd.Position + bd.ObjectVelocity * (ping + extra)
	if bd.LagStuck then predBall = bd.Position end
	local bVel    = (bd.LagStuck and bd.LastKnownVelocity)
		or bd.Velocity or Vector3.zero
	local relVel  = bVel - hrpVel
	local relObjV = bd.ObjectVelocity - hrpVel
	local dotRaw  = hrpVel.Magnitude > 1
		and Physics.dot(bd.Position, hrpPos, hrpVel) or 0
	local dotPred = hrpVel.Magnitude > 1
		and Physics.dot(predBall, predHRP, hrpVel) or 0
	local px     = (ParryConfig.PerfectParry and ParryConfig.PerfectX) or 0
	local totalT = (ping + extra) * ParryConfig.PingComp
	local maxEta = ParryConfig.ETA + totalT
		+ math.abs(math.clamp(dotRaw, -1, 1)) * (1 - px) * totalT
	local maxDot = math.rad(ParryConfig.DotPoint) + math.rad(180 * totalT)
		+ math.acos(math.clamp(dotRaw, -1, 1))
		* math.abs(math.clamp(dotRaw, -1, 1)) / math.pi

	local function check(origin, pos, vel, dot)
		local etas = {
			Physics.eta(pos, origin, vel),
			Physics.eta(pos, origin, vel, 2.5),
		}
		local dots = {
			math.acos(math.clamp(Physics.dot(pos, origin, vel),      -1, 1)),
			math.acos(math.clamp(Physics.dot(pos, origin, vel, 2.5), -1, 1)),
		}
		if Physics.deflectable(etas, dots, maxEta, maxDot) then return true end
		local dist2  = (pos - origin).Magnitude
		local etaMag = Physics.eta(pos, origin, vel).Magnitude
		if etaMag <= 0.3 + (ping + extra)
		and math.acos(math.clamp(
			Physics.dot(pos, origin, vel), -1, 1)) <= math.pi / 3 then
			local adj = dot > 0 and dot * 4 or (dot < 0 and dot * -4 or 0)
			if dist2 <= 8 + 8 * (ping + extra) + adj then return true end
		end
		local adj2 = dot > 0 and dot * 3 or (dot < 0 and dot * -3 or 0)
		return dist2 <= 3 + 8 * (ping + extra) + adj2
	end

	local ok1 = check(hrpPos,  bd.Position, relVel,  dotRaw)
		and check(hrpPos,  bd.Position, relObjV, dotRaw)
	local ok2 = check(predHRP, predBall,    relVel,  dotPred)
		and check(predHRP, predBall,    relObjV, dotPred)
	if not ok1 and not ok2 then return false end

	local rpf = BallSystem.RPFilter
	rpf[#rpf + 1] = bd.Object
	BallSystem.RP.FilterDescendantsInstances = rpf
	local dir2 = predBall - hrpPos
	local hit  = Workspace:Raycast(hrpPos, dir2, BallSystem.RP)
	rpf[#rpf]  = nil
	if dir2.Magnitude > 8 and not bd.isPhasingThrough and hit then
		local inst = hit.Instance
		if inst.Transparency < 1
		and inst.CollisionGroup ~= "BallCollider"
		and inst.CollisionGroup ~= "NoCollide" then
			return false
		end
	end
	return true
end

function AutoParry.fire()
	ACB.clearBuffers()
	Utils.pressF()
	BallSystem.LastParried = os.clock()
end

function AutoParry.startAuto()
	if systemConns.AutoParry then
		systemConns.AutoParry:Disconnect()
		systemConns.AutoParry = nil
	end
	systemConns.AutoParry = RunService.PostSimulation:Connect(function()
		if not State.AutoParry then
			systemConns.AutoParry:Disconnect()
			systemConns.AutoParry = nil
			return
		end
		if BallSystem.Yield then return end
		local hrp = Utils.hrp(); if not hrp then return end
		local pos  = hrp.Position
		local vel  = hrp.AssemblyLinearVelocity
		local ping = Utils.ping()
		local cands = {}
		for _, bd in pairs(BallSystem.Balls) do
			if bd.Type == "Default"
			and AutoParry.gate(bd, pos)
			and AutoParry.confirm(bd, ping, 0.025, pos, vel) then
				cands[#cands + 1] = bd
			end
		end
		if #cands == 0 then return end
		BallSystem.Yield = true
		AutoParry.fire()
		if #cands > 1 then
			task.spawn(function()
				for _ = 2, #cands do
					RunService.Heartbeat:Wait()
					AutoParry.fire()
				end
			end)
		end
		BallSystem.ParriedLoop = {}
		local loop = BallSystem.ParriedLoop
		local done = Utils.timer(ParryConfig.YieldAfter)
		while not done() and loop == BallSystem.ParriedLoop do
			task.wait()
		end
		BallSystem.Yield = false
	end)
end

