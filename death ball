		Saito        = {{1,0},{2,50},{3,80}},
		Misaki       = {{1,0},{3,40},{4,85}},
		["Dr. Stone"]= {{1,20},{2,50}},
	},
}

function SkillSystem.detect()
	local hud = LocalPlayer:FindFirstChild("PlayerGui")
	if hud then hud = hud:FindFirstChild("HUD") end
	if not hud then return nil, nil end
	local frame = hud:FindFirstChild("HolderLeftBottom")
	if frame then frame = frame:FindFirstChild("ChampionLevelFrame") end
	if not frame then return nil, nil end
	local lbl = frame:FindFirstChild("ChampionLabel")
	if not lbl or lbl.Text == "" then return nil, nil end
	local parts = string.split(lbl.Text, "~")
	if #parts < 2 then return nil, nil end
	return parts[1]:match("^%s*(.-)%s*$"),
	       tonumber(parts[2]:match("%d+"))
end

function SkillSystem.refresh()
	local champ, level = SkillSystem.detect()
	if not champ or not level then return end
	if champ == SkillSystem.Champion
	and level == SkillSystem.Level then return end
	SkillSystem.Champion  = champ
	SkillSystem.Level     = level
	SkillSystem.Index     = 1
	SkillSystem.Available = {}
	local skills = SkillSystem.Champions[champ]
	if not skills then return end
	for _, s in ipairs(skills) do
		if level >= s[2] then
			SkillSystem.Available[#SkillSystem.Available + 1] = s[1]
		end
	end
end

function SkillSystem.getToolbar()
	local hud = LocalPlayer:FindFirstChild("PlayerGui")
	if hud then hud = hud:FindFirstChild("HUD") end
	if not hud then return nil end
	local h = hud:FindFirstChild("HolderBottom")
	if h then h = h:FindFirstChild("ToolbarButtons") end
	return h
end

function SkillSystem.isReady(slot)
	local tb  = SkillSystem.getToolbar(); if not tb then return false end
	local btn = tb:FindFirstChild("AbilityButton" .. slot)
	if not btn then return false end
	local cd = btn:FindFirstChild("Cooldown")
	if cd and cd.Visible then return false end
	local r = math.floor(btn.BackgroundColor3.R * 255 + 0.5)
	local g = math.floor(btn.BackgroundColor3.G * 255 + 0.5)
	local b = math.floor(btn.BackgroundColor3.B * 255 + 0.5)
	return not (r == 98 and g == 98 and b == 98)
end

function SkillSystem.deflectProgress()
	local tb   = SkillSystem.getToolbar()
	if not tb then return 0, false end
	local dbtn = tb:FindFirstChild("DeflectButton")
	local cd   = dbtn and dbtn:FindFirstChild("Cooldown")
	local uig  = cd   and cd:FindFirstChild("UIGradient")
	local kps  = uig  and uig.Transparency and uig.Transparency.Keypoints
	if not kps then return 0, cd and cd.Visible or false end
	local n = 0
	for _, kp in ipairs(kps) do
		if kp.Value >= 0.99 and n < kp.Time then n = kp.Time end
	end
	return n, cd.Visible
end

function SkillSystem.canSubstituteParry()
	local prog, visible = SkillSystem.deflectProgress()
	return visible and prog >= SkillSystem.DeflectProg
end

function SkillSystem.tryUse(now)
	if #SkillSystem.Available == 0
	or now - SkillSystem.LastTry < SkillSystem.Cooldown then
		return false
	end
	for i = 1, #SkillSystem.Available do
		local idx  = (SkillSystem.Index - 1 + i - 1)
			% #SkillSystem.Available + 1
		local slot = SkillSystem.Available[idx]
		if SkillSystem.isReady(slot) then
			Utils.pressKey(SkillSystem.Keys[slot])
			SkillSystem.LastTry = now
			SkillSystem.Index   = SkillSystem.Index
				% #SkillSystem.Available + 1
			return true
		end
	end
	SkillSystem.Index = SkillSystem.Index % #SkillSystem.Available + 1
	return false
end

function SkillSystem.tick()
	if not State.AutoSkill then return end
	if BallSystem.SpamDebounce or BallSystem.ManualSpam then return end
	if BallSystem.SpamEndedAt > 0
	and os.clock() - BallSystem.SpamEndedAt < ParryConfig.SkillGrace then
		return
	end
	local now = os.clock()
	if now - SkillSystem.LastCheck >= SkillSystem.CheckEvery then
		SkillSystem.refresh()
		SkillSystem.LastCheck = now
	end
	if not Utils.highlightActive() then return end
	local hrp    = Utils.hrp()
	local active = BallSystem.Active
	if not hrp or not active then return end
	if (active.Position - hrp.Position).Magnitude
	> SkillSystem.ActivateAt then return end
	if not SkillSystem.canSubstituteParry() then return end
	SkillSystem.tryUse(now)
end

function SkillSystem.start()
	if systemConns.AutoSkill then return end
	SkillSystem.LastTry   = 0
	SkillSystem.Index     = 1
	SkillSystem.LastCheck = 0
	SkillSystem.refresh()
	systemConns.AutoSkill = RunService.Heartbeat:Connect(SkillSystem.tick)
end

function SkillSystem.stop()
	if systemConns.AutoSkill then
		systemConns.AutoSkill:Disconnect()
		systemConns.AutoSkill = nil
	end
	SkillSystem.Champion  = nil
	SkillSystem.Level     = nil
	SkillSystem.Available = {}
end

