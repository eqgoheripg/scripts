local Utils = {}

function Utils.timer(t)
	local s = os.clock()
	return function() return os.clock() - s >= (t or 0) end
end

function Utils.hrp()
	local char = LocalPlayer.Character
	local hum  = char and char:FindFirstChildWhichIsA("Humanoid")
	return hum and hum.RootPart
end

function Utils.pingDist()
	local ms
	if State.Comp.auto then
		local ok, v = pcall(function() return LocalPlayer:GetNetworkPing() end)
		ms = ok and v or 0.04
	else
		ms = State.Comp.manualMs / 1000
	end
	local m = ms * 1000
	if     m <= 20  then return 10, ms
	elseif m <= 80  then return 10 + (m-20)*10/60, ms
	elseif m <= 150 then return 20 + (m-80)*5/70, ms
	elseif m <= 300 then return 25 + (m-150)*5/150, ms
	else                  return 30, ms end
end

function Utils.ping()
	local dist, sec = Utils.pingDist()
	if not State.Comp.auto then return sec end
	local a   = BallSystem.Active
	local spd = a and a.Velocity and a.Velocity.Magnitude or 0
	if spd < 1 then return math.clamp(sec, 0.03, 0.3) end
	return math.clamp(dist / spd + sec, 0.03, 0.3)
end

