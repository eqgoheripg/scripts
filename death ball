-- PHYSICS
-- ============================================================
local Physics = {}

function Physics.eta(pos, origin, vel, radius)
	local d = pos - origin
	radius = radius or 0
	if d.Magnitude ~= 0 then d = d - d.Unit * radius end
	if vel.Magnitude == 0 then return Vector3.new(1e9, 1e9, 1e9) end
	return d / vel.Magnitude
end

function Physics.dot(pos, origin, vel, radius)
	radius = radius or 0
	local d = pos - origin
	if d.Magnitude == 0 or vel.Magnitude == 0 then return 0 end
	local adj = d - d.Unit * radius
	if adj.Magnitude == 0 then return 0 end
	local v = adj.Unit:Dot(vel.Unit)
	return v == v and v or 0
end

function Physics.deflectable(etas, dots, maxEta, maxDot)
	for _, e in ipairs(etas) do if maxEta < e.Magnitude then return false end end
	for _, d in ipairs(dots) do if maxDot < d           then return false end end
	return true
end

