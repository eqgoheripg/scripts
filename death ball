function Utils.removeMeta(obj)
	pcall(function()
		local mt = getrawmetatable(obj)
		if type(mt) ~= "table" then return end
		local clean = {}
		for k, v in pairs(mt) do
			if k ~= "__newindex" and k ~= "__metatable" then clean[k] = v end
		end
		setrawmetatable(obj, clean)
	end)
end

function Utils.rebuildRPFilter()
	local f = BallSystem.RPFilter
	for i = #f, 1, -1 do f[i] = nil end
	f[#f+1] = LocalPlayer
	if LocalPlayer.Character then f[#f+1] = LocalPlayer.Character end
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= LocalPlayer and pl.Character then f[#f+1] = pl.Character end
	end
	BallSystem.RP.FilterDescendantsInstances = f
end

