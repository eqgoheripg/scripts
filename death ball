local FBS = {
	conn           = nil,
	SAFE_DISTANCE  = 20,
	DIST_TOLERANCE = 3,
	ORBIT_SPEED    = 1.5,
	angle          = 0,
	orbitDirection = 1,
}

local function followBallStart()
	if FBS.conn then return end
	FBS.angle          = 0
	FBS.orbitDirection = math.random(1, 2) == 1 and 1 or -1
	FBS.conn = RunService.Heartbeat:Connect(function()
		if not State.FollowBall then return end
		if LocalPlayer:GetAttribute("IsInGame") ~= true then return end
		local char = LocalPlayer.Character
		local hrp  = char and char:FindFirstChild("HumanoidRootPart")
		local hum  = char and char:FindFirstChild("Humanoid")
		if not hrp or not hum then return end
		local bp = BallSystem.Active and BallSystem.Active.Position
		if not bp then return end
		local safeD = FBS.SAFE_DISTANCE
		local myPos = hrp.Position
		local flat  = Vector3.new(bp.X, 0, bp.Z)
		local diff  = Vector3.new(myPos.X, 0, myPos.Z) - flat
		local mag   = diff.Magnitude
		if mag < 0.1 then diff = Vector3.new(safeD, 0, 0); mag = safeD end
		local unit = diff.Unit
		local perp = Vector3.new(-unit.Z, 0, unit.X)
		local dest
		if mag < safeD - FBS.DIST_TOLERANCE then
			local t = flat + (unit + perp * 0.7).Unit * safeD
			dest = Vector3.new(t.X, myPos.Y, t.Z)
		elseif mag > safeD + FBS.DIST_TOLERANCE then
			local t = flat + unit * safeD
			dest = Vector3.new(t.X, myPos.Y, t.Z)
		else
			FBS.angle = FBS.angle
				+ FBS.orbitDirection * FBS.ORBIT_SPEED * 0.05
			local t = flat
				+ (unit * math.cos(FBS.angle)
				+  perp * math.sin(FBS.angle)) * safeD
			dest = Vector3.new(t.X, myPos.Y, t.Z)
		end
		if (hrp.Position - dest).Magnitude > 1 then
			hum:MoveTo(dest)
		end
	end)
end

local function followBallStop()
	if FBS.conn then FBS.conn:Disconnect(); FBS.conn = nil end
	FBS.angle = 0; FBS.orbitDirection = 1
	local char = LocalPlayer.Character
	local hum  = char and char:FindFirstChild("Humanoid")
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if hum and hrp then hum:MoveTo(hrp.Position) end
end

