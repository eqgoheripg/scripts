local ACB = {
	Loaded      = false,
	Neutralized = {},
	Infos       = nil,
	Paths       = nil,
	Names       = {
		"DEFLECT_CTX","DEFLECT_CTS_2","DEFLECT_CTS",
		"DEFLECT_CHECK","DEFLECT_VERIFY","DEFLECT_REPORT"
	},
	NameSet = {},
}
for _, n in ipairs(ACB.Names) do ACB.NameSet[n] = true end

function ACB.neutralize(tbl, key)
	if type(tbl) ~= "table" or ACB.Neutralized[key] then return end
	for k, v in pairs(tbl) do
		if type(v) == "function" then
			pcall(function() rawset(tbl, k, function() end) end)
		end
	end
	ACB.Neutralized[key] = true
end

function ACB.findBuffers(fn)
	if type(fn) ~= "function" then return end
	if not debug or not debug.getupvalue then return end
	for i = 1, 64 do
		pcall(function()
			local v0 = debug.getupvalue(fn, i)
			local vm1 = debug.getupvalue(fn, i-1)
			local vp1 = debug.getupvalue(fn, i+1)
			local vp2 = debug.getupvalue(fn, i+2)
			if v0 == getmetatable
			and type(vm1) == "table"
			and type(vp1) == "table"
			and type(vp2) == "table" then
				ACB.Infos = vp1
				ACB.Paths = vp2
			end
		end)
	end
end

function ACB.scan(obj)
	for _, name in ipairs(ACB.Names) do
		if not ACB.Neutralized[name] then
			pcall(function()
				local t = obj[name]
				if type(t) == "table" then ACB.neutralize(t, name) end
			end)
		end
	end
end

function ACB.setup()
	if ACB.Loaded then return true end
	local Actions = ReplicatedStorage:FindFirstChild("Actions")
	if not Actions then return false end
	local ok, result = pcall(require, Actions)
	if not ok or type(result) ~= "table" then return false end
	local mt = pcall(getrawmetatable, result) and getrawmetatable(result)
	if type(mt) ~= "table" then return false end
	pcall(function() rawset(mt, "__tostring", function() return "{}" end) end)
	local _, indexFn = pcall(function() return rawget(mt, "__index") end)
	ACB.findBuffers(indexFn)
	ACB.scan(result)
	local _, origNI = pcall(function() return rawget(mt, "__newindex") end)
	pcall(function()
		rawset(mt, "__newindex", function(tbl, key, val)
			if ACB.NameSet[key] and type(val) == "table" then
				ACB.neutralize(val, key)
			end
			if origNI then return origNI(tbl, key, val) end
			pcall(function() rawset(tbl, key, val) end)
		end)
	end)
	task.spawn(function()
		while true do ACB.scan(result) task.wait(1) end
	end)
	ACB.Loaded = true
	return true
end

function ACB.clearBuffers()
	if ACB.Infos then
		for k in pairs(ACB.Infos) do ACB.Infos[k] = nil end
	end
	if ACB.Paths then
		for k in pairs(ACB.Paths) do ACB.Paths[k] = nil end
	end
end

task.spawn(function()
	for _ = 1, 60 do
		if ACB.setup() then return end
		task.wait(0.5)
	end
end)

